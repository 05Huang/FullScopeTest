# FullScopeTest Backend 环境变量配置示例
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# 注意: .env 文件不应提交到版本控制

# ===== Flask 配置 =====
FLASK_ENV=development
FLASK_APP=wsgi.py

# ===== 安全密钥 (必须修改!) =====
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-a-random-secret-key>
JWT_SECRET_KEY=<generate-a-random-jwt-secret-key>

# ===== 数据库配置 =====
# PostgreSQL
DATABASE_URL=postgresql+psycopg2://fullscopetest:<your-password>@127.0.0.1:5432/fullscopetest_dev
# SQLite (开发环境简单配置)
# DATABASE_URL=sqlite:///instance/fullscopetest.db

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0

# ===== Celery 配置 =====
CELERY_ENABLE=true
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ===== 报告和上传存储路径 =====
REPORT_FOLDER=./reports
UPLOAD_FOLDER=./uploads

# ===== AI 助手配置 (可选) =====
AI_ASSISTANT_ENABLED=true
# DeepSeek
AI_ASSISTANT_BASE_URL=https://api.deepseek.com
AI_ASSISTANT_API_KEY=<your-deepseek-api-key>
AI_ASSISTANT_MODEL=deepseek-chat
AI_ASSISTANT_TIMEOUT=60
# 或 OpenAI
# AI_ASSISTANT_BASE_URL=https://api.openai.com/v1
# AI_ASSISTANT_API_KEY=<your-openai-api-key>
# AI_ASSISTANT_MODEL=gpt-4o-mini

# ===== AI 视觉模型配置 (可选) =====
# 阿里云 DashScope
AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_VISION_API_KEY=<your-dashscope-api-key>
AI_VISION_MODEL=qwen-vl-max
# 或 OpenAI
# AI_VISION_BASE_URL=https://api.openai.com/v1
# AI_VISION_API_KEY=<your-openai-api-key>
# AI_VISION_MODEL=gpt-4o

# ===== AI 探索测试 Live View 配置 (可选) =====
AI_EXPLORE_LIVE_VIEW_INTERNAL_URL_TEMPLATE=http://127.0.0.1:6080/vnc.html?autoconnect=1&resize=remote&view_only=0&session_id={session_id}
AI_EXPLORE_BROWSER_HEADLESS=false
AI_EXPLORE_BROWSER_SLOW_MO=120

# ===== 阿里云 OSS 配置 (可选，用于文件上传) =====
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=<your-oss-access-key-id>
OSS_ACCESS_KEY_SECRET=<your-oss-access-key-secret>
OSS_BUCKET_NAME=<your-bucket-name>
OSS_DOMAIN=

# ===== 性能测试限制 =====
# PERF_TEST_MIN_USERS=1
# PERF_TEST_MAX_USERS=2000
# PERF_TEST_MIN_SPAWN_RATE=1
# PERF_TEST_MAX_SPAWN_RATE=50
# PERF_TEST_MIN_DURATION=10
# PERF_TEST_MAX_DURATION=3600

# ===== Playwright 配置 =====
# 设置为 1 跳过浏览器安装（CI 环境）
# SKIP_PLAYWRIGHT_BROWSERS=1

# ===== SSO 单点登录配置 (可选) =====
# --- OIDC ---
# OIDC_ISSUER_URL=https://accounts.google.com
# OIDC_CLIENT_ID=<your-client-id>
# OIDC_CLIENT_SECRET=<your-client-secret>
# OIDC_SCOPES=openid email profile

# --- LDAP ---
# LDAP_SERVER_URL=ldap://ldap.example.com:389
# LDAP_BASE_DN=dc=example,dc=com
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=<bind-password>
# LDAP_USER_SEARCH_FILTER=(uid={username})
# LDAP_USER_ATTR_MAP={"email":"mail","username":"uid","display_name":"cn"}

# FRONTEND_URL=http://localhost:5173
